# Copy to .env (untracked) for local dev. Never commit real values.

# --- api ---
# Port the API listens on. Railway sets this itself.
PORT=3000
# Bind address. `::` covers IPv4 and IPv6 (Railway's private network is IPv6).
HOST=::
# Shared bearer token for /mcp until task 3 adds per-agent tokens. At least 32 chars.
# Generate one with: openssl rand -base64 32
NACRE_DEV_TOKEN=

# --- worker ---
# How often the worker polls for jobs, in ms.
WORKER_POLL_MS=1000

# --- database (Postgres 18 + pgvector; see README "Database") ---
# Owner (admin) URL for dbmate (`pnpm db:migrate`) and `pnpm db:verify`. Local Docker uses trust auth,
# so no password. On Railway this is the database's own DATABASE_URL, set by .railway/railway.ts.
MIGRATION_DATABASE_URL=postgres://postgres@localhost:54329/nacre_dev?sslmode=disable
# Admin URL the test suite uses to create, migrate and drop a scratch database. Unset: DB tests skip.
TEST_DATABASE_URL=postgres://postgres@localhost:54329/postgres?sslmode=disable

# --- both ---
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Set automatically on Railway (RAILWAY_GIT_COMMIT_SHA); for other builds, the commit to report in /healthz.
GIT_COMMIT=

# --- later slice 1 tasks (not read yet; spec §12.1) ---
# DATABASE_URL=postgres://nacre_app:<password>@<host>:5432/<db>   # task 3: runtime connection as nacre_app
# TOKEN_PEPPER=            # task 3
# OWNER_PASSWORD_HASH=     # task 13
# LLM_API_KEY=             # task 5
# LLM_MODEL=gpt-6-luna
# EMBEDDING_API_KEY=       # task 9
# EMBEDDING_MODEL=text-embedding-3-small
# PUBLIC_API_URL=https://api.nacre.so
# PUBLIC_APP_URL=https://app.nacre.so
# DAILY_LLM_BUDGET_USD=0.50
