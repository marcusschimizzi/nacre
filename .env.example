# Copy to .env (untracked) for local dev. Never commit real values.

# --- api ---
# Port the API listens on. Railway sets this itself.
PORT=3000
# Bind address. `::` covers IPv4 and IPv6 (Railway's private network is IPv6).
HOST=::
# Shared bearer token for /mcp until task 3 adds per-agent tokens. At least 32 chars.
# Generate one with: openssl rand -base64 32
NACRE_DEV_TOKEN=

# --- worker ---
# How often the worker polls for jobs, in ms.
WORKER_POLL_MS=1000

# --- both ---
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Set automatically on Railway (RAILWAY_GIT_COMMIT_SHA); for other builds, the commit to report in /healthz.
GIT_COMMIT=

# --- later slice 1 tasks (not read yet; spec §12.1) ---
# DATABASE_URL=            # task 2: Postgres 18 + pgvector, via the `postgres` (postgres.js) client
# TOKEN_PEPPER=            # task 3
# OWNER_PASSWORD_HASH=     # task 13
# LLM_API_KEY=             # task 5
# LLM_MODEL=gpt-6-luna
# EMBEDDING_API_KEY=       # task 9
# EMBEDDING_MODEL=text-embedding-3-small
# PUBLIC_API_URL=https://api.nacre.so
# PUBLIC_APP_URL=https://app.nacre.so
# DAILY_LLM_BUDGET_USD=0.50
