# Copy to .env (untracked) for local dev. Never commit real values.

# --- api ---
# Port the API listens on. Railway sets this itself.
PORT=3000
# Bind address. `::` covers IPv4 and IPv6 (Railway's private network is IPv6).
HOST=::
# Runtime database connection, as nacre_app (never the owner). Locally trust auth needs no password;
# nacre_app needs LOGIN first: `pnpm nacre db app-login` (reads NACRE_APP_DB_PASSWORD below).
DATABASE_URL=postgres://nacre_app@localhost:54329/nacre_dev?sslmode=disable
# HMAC key for token secrets, at least 32 chars: openssl rand -base64 32
# Changing it invalidates every token. `pnpm nacre token create` needs it too.
TOKEN_PEPPER=
# This API's public origin (no path): the OAuth issuer and the base of the /mcp resource.
PUBLIC_API_URL=http://localhost:3000
# Optional: the web app's origin, and the origins allowed to call /mcp from a browser
# (comma-separated; default PUBLIC_API_URL plus PUBLIC_APP_URL).
# PUBLIC_APP_URL=
# ALLOWED_ORIGINS=

# --- worker ---
# How often the worker polls for jobs, in ms.
WORKER_POLL_MS=1000

# --- database (Postgres 18 + pgvector; see README "Database") ---
# Owner (admin) URL for `pnpm db:migrate`, `db:verify`, `db:predeploy` and `nacre db …`. Local Docker
# uses trust auth, so no password. On Railway it's the database's own DATABASE_URL (.railway/railway.ts).
MIGRATION_DATABASE_URL=postgres://postgres@localhost:54329/nacre_dev?sslmode=disable
# nacre_app's password, applied by the pre-deploy step (`nacre db app-login`). Printable ASCII, 16+
# chars: openssl rand -hex 32. Locally any value works (trust auth); unset leaves the role alone.
NACRE_APP_DB_PASSWORD=
# Admin URL the test suite uses to create, migrate and drop a scratch database. Unset: DB tests skip.
TEST_DATABASE_URL=postgres://postgres@localhost:54329/postgres?sslmode=disable

# --- both ---
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Set automatically on Railway (RAILWAY_GIT_COMMIT_SHA); for other builds, the commit to report in /healthz.
GIT_COMMIT=

